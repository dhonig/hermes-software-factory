# Copy to factory.conf (git-ignored) and edit.

# The repository the factory works on. Each build task gets its own worktree
# under <repo>/.worktrees/.
TARGET_REPO="$HOME/IdeaProjects/my-app"

# Kanban board used only by the factory.
BOARD="software-factory"
BOARD_NAME="Software Factory"

# Role profiles are named <prefix><role>, e.g. sf-planner.
PROFILE_PREFIX="sf-"

# Guardrails from the article: few workers, small failure budget.
MAX_IN_PROGRESS=2               # tasks running at once across the board
MAX_IN_PROGRESS_PER_PROFILE=1   # one worker per role at a time
FAILURE_LIMIT=2                 # consecutive failures before a task is blocked

# Model for the Backend and Frontend builders (empty = same as default profile).
# Must be a model your default provider serves.
BUILDER_MODEL="Qwen3-Coder-Next-5bit"
# Model for the Integrator (resolves merge conflicts). Empty = BUILDER_MODEL.
INTEGRATOR_MODEL=""

# Escalation: hand a stuck build task to headless Claude Code (needs `claude auth login`).
ESCALATE_AUTO=0                 # 1 = factory-watch escalates compile failures, once per task
ESCALATE_MAX_TURNS=40
ESCALATE_MAX_BUDGET_USD=5       # hard stop per escalation

# Hard limits, in seconds (0 = no limit). check.sh and the smoke test run in
# their own process group; on timeout, or when they finish, everything they
# started (trunk serve, debug backends) is killed.
CHECK_TIMEOUT=1800              # factory.sh check (./check.sh)
SMOKE_TIMEOUT=900               # factory.sh smoke

# Discord channel IDs (written here by scripts/discord-setup.sh).
DISCORD_NOTIFY_CHANNEL=""
DISCORD_GUILD_ID=""
